<?xml version="1.0" encoding="utf-8"?>
<!--
  文案编辑器：一条一条的输入框，行由 LockSettingsFragment 动态加删（见 item_quote_row）。
  列表给固定高度：AlertDialog 的自定义 view 没法用 weight 撑，高度不定的话
  文案一多就会把「保存 / 取消」顶出屏幕。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="2dp">

    <!-- 说明 + 条数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            app:srcCompat="@android:drawable/ic_menu_edit"
            app:tint="?attr/colorBrandContent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"
            android:text="@string/lock_quotes_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/quoteCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_value_chip"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:textColor="?attr/colorBrandContent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/quoteScroll"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quoteRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quoteAddButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/lock_quotes_add"
        android:textColor="?attr/colorBrandContent"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="?attr/colorBrandContent"
        app:strokeColor="?attr/colorOutline" />
</LinearLayout>
