<?xml version="1.0" encoding="utf-8"?>
<!--
  文案编辑器：一条一条的输入框，行由 LockSettingsFragment 动态加删（见 item_quote_row）。
  列表给固定高度：AlertDialog 的自定义 view 没法用 weight 撑，高度不定的话
  文案一多就会把「保存 / 取消」顶出屏幕。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="@string/lock_quotes_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/quoteScroll"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quoteRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quoteAddButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lock_quotes_add"
        android:textColor="?attr/colorBrandAccent"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="?attr/colorBrandAccent" />
</LinearLayout>
