<?xml version="1.0" encoding="utf-8"?>
<com.xian.focus.SwipeActionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/taskSwipeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 左滑露出的动作行：压在内容层底下，宽度由 SwipeActionLayout 按可用宽度算 -->
    <LinearLayout
        android:id="@+id/taskSwipeActions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/actionDone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/swipe_action_done"
            android:contentDescription="@string/complete_task"
            android:scaleType="center"
            android:src="@drawable/ic_swipe_done" />

        <ImageView
            android:id="@+id/actionMoveUp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/swipe_action_move_up"
            android:contentDescription="@string/swipe_action_move_up"
            android:scaleType="center"
            android:src="@drawable/ic_swipe_up" />

        <ImageView
            android:id="@+id/actionMoveDown"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/swipe_action_move_down"
            android:contentDescription="@string/swipe_action_move_down"
            android:scaleType="center"
            android:src="@drawable/ic_swipe_down" />

        <ImageView
            android:id="@+id/actionDelete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/swipe_action_delete"
            android:contentDescription="@string/delete_task"
            android:scaleType="center"
            android:src="@drawable/ic_delete_task"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/taskContentCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- 主行：序号 + 标题/标签 + 番茄数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 序号方框 -->
            <TextView
                android:id="@+id/taskNumberText"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                android:background="@drawable/bg_task_number" />

            <!-- 中间：标题 + 重复标签 + 元信息 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/taskTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/taskTitleStrikeLine"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/completed_grey"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/taskRepeatTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="2dp"
                        android:textColor="?attr/colorBrandContent"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/taskCategoryTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_category_tag"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右侧：番茄数 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <ImageButton
                    android:id="@+id/timerButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/start_pomodoro_desc"
                    app:srcCompat="@android:drawable/ic_lock_idle_alarm"
                    app:tint="?attr/colorBrandContent" />

                <TextView
                    android:id="@+id/taskCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="?attr/colorBrandContent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 描述 -->
        <TextView
            android:id="@+id/taskDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 截止日期 -->
        <TextView
            android:id="@+id/taskDueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="?attr/colorSecondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 子任务区域 -->
        <LinearLayout
            android:id="@+id/subtaskSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/subtaskToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/collapse"
                android:textColor="?attr/colorBrandContent"
                android:textSize="12sp"
                android:background="?attr/selectableItemBackground" />

            <LinearLayout
                android:id="@+id/subtaskContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 图片区域 -->
        <LinearLayout
            android:id="@+id/imageSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/imageToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@review_images"
                android:textColor="?attr/colorBrandContent"
                android:textSize="12sp"
                android:background="?attr/selectableItemBackground" />

            <ImageView
                android:id="@+id/taskImageView"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="6dp"
                android:scaleType="centerCrop"
                android:background="@color/card_surface_alt"
                android:visibility="gone"
                android:contentDescription="@string/task_image" />
        </LinearLayout>

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startTaskButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:minHeight="34dp"
                android:layout_weight="1"
                android:textSize="11sp"
                android:paddingHorizontal="2dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/toggleTaskButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:minHeight="34dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                android:paddingHorizontal="2dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/deleteTaskButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:minHeight="34dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/delete_task"
                android:textColor="@color/danger"
                android:textSize="11sp"
                android:paddingHorizontal="2dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</com.xian.focus.SwipeActionLayout>
