<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme_settings"
            android:textColor="@color/ink_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/themeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/themeQinglv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_qinglv"
                android:textColor="@color/ink_text"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/themeZhusha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_zhusha"
                android:textColor="@color/ink_text"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/themeDailan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_dailan"
                android:textColor="@color/ink_text"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/themeXuanmo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_xuanmo"
                android:textColor="@color/ink_text"
                android:textSize="14sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="?attr/colorOutline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallpaper_settings"
            android:textColor="@color/ink_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/wallpaperPreview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <Button
            android:id="@+id/selectWallpaperButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="?attr/colorBrandSurface"
            android:text="@string/select_wallpaper"
            android:textColor="@color/on_primary" />

        <Button
            android:id="@+id/restoreWallpaperButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/restore_wallpaper" />
    </LinearLayout>
</ScrollView>
