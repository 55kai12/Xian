<?xml version="1.0" encoding="utf-8"?>
<!-- 文案编辑器里的一条：点缀色竖条 + 输入框 + 删除按钮。行由 LockSettingsFragment 动态加/删。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:layout_width="3dp"
        android:layout_height="30dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_accent_bar"
        android:contentDescription="@null" />

    <EditText
        android:id="@+id/quoteRowInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_quote_input"
        android:hint="@string/lock_quotes_row_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="2"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/quoteRowDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/lock_quotes_row_delete"
        android:padding="9dp"
        app:srcCompat="@drawable/ic_note_trash"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
