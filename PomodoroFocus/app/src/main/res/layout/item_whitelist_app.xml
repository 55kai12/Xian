<?xml version="1.0" encoding="utf-8"?>
<!--
  锁机覆盖层里的白名单应用行。
  底色是半透明白，直接叠在品牌色上，所以不用为每套主题各配一份。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/whitelistAppCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/overlay_card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/overlay_divider">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp">

        <ImageView
            android:id="@+id/whitelistAppIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/whitelistAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/on_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_open"
            android:textColor="@color/on_primary_dim"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
