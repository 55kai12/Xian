<resources>
    <!--
      基础主题：
        - 父级用 DayNight，系统开深色时自动切到 values-night/colors.xml
        - 所有颜色改为引用 @color 命名资源，才能被 values-night 覆盖
        - 主色分两个角色：colorBrandSurface(做底) / colorBrandContent(做字)
    -->
    <style name="Theme.Xian" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:textColorPrimary">@color/default_text_color</item>
        <item name="android:textColorSecondary">@color/secondary_text_color</item>
        <item name="materialButtonStyle">@style/Widget.Xian.Button</item>
        <item name="editTextStyle">@style/Widget.Xian.EditText</item>
        <item name="alertDialogTheme">@style/Theme.Xian.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.Xian.MaterialAlertDialog</item>
        <item name="colorSecondary">@color/theme_qinglv_accent</item>
        <item name="colorBrandAccent">@color/theme_qinglv_accent</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorBrandSurface">@color/theme_qinglv_primary</item>
        <item name="colorBrandContent">@color/theme_qinglv_primary_content</item>
    </style>

    <style name="Theme.Xian.Qinglv" parent="Theme.Xian">
        <item name="colorPrimary">@color/theme_qinglv_primary</item>
        <item name="colorPrimaryVariant">@color/theme_qinglv_primary_variant</item>
        <item name="colorBrandSurface">@color/theme_qinglv_primary</item>
        <item name="colorBrandContent">@color/theme_qinglv_primary_content</item>
        <item name="colorSecondary">@color/theme_qinglv_accent</item>
        <item name="colorBrandAccent">@color/theme_qinglv_accent</item>
        <item name="android:colorAccent">@color/theme_qinglv_accent</item>
        <item name="android:windowBackground">@color/theme_qinglv_surface</item>
        <item name="colorSurface">@color/theme_qinglv_surface</item>
        <item name="android:statusBarColor">@color/theme_qinglv_primary_variant</item>
    </style>

    <style name="Theme.Xian.Zhusha" parent="Theme.Xian">
        <item name="colorPrimary">@color/theme_zhusha_primary</item>
        <item name="colorPrimaryVariant">@color/theme_zhusha_primary_variant</item>
        <item name="colorBrandSurface">@color/theme_zhusha_primary</item>
        <item name="colorBrandContent">@color/theme_zhusha_primary_content</item>
        <item name="colorSecondary">@color/theme_zhusha_accent</item>
        <item name="colorBrandAccent">@color/theme_zhusha_accent</item>
        <item name="android:colorAccent">@color/theme_zhusha_accent</item>
        <item name="android:windowBackground">@color/theme_zhusha_surface</item>
        <item name="colorSurface">@color/theme_zhusha_surface</item>
        <item name="android:statusBarColor">@color/theme_zhusha_primary_variant</item>
    </style>

    <style name="Theme.Xian.Dailan" parent="Theme.Xian">
        <item name="colorPrimary">@color/theme_dailan_primary</item>
        <item name="colorPrimaryVariant">@color/theme_dailan_primary_variant</item>
        <item name="colorBrandSurface">@color/theme_dailan_primary</item>
        <item name="colorBrandContent">@color/theme_dailan_primary_content</item>
        <item name="colorSecondary">@color/theme_dailan_accent</item>
        <item name="colorBrandAccent">@color/theme_dailan_accent</item>
        <item name="android:colorAccent">@color/theme_dailan_accent</item>
        <item name="android:windowBackground">@color/theme_dailan_surface</item>
        <item name="colorSurface">@color/theme_dailan_surface</item>
        <item name="android:statusBarColor">@color/theme_dailan_primary_variant</item>
    </style>

    <style name="Theme.Xian.Xuanmo" parent="Theme.Xian">
        <item name="colorPrimary">@color/theme_xuanmo_primary</item>
        <item name="colorPrimaryVariant">@color/theme_xuanmo_primary_variant</item>
        <item name="colorBrandSurface">@color/theme_xuanmo_primary</item>
        <item name="colorBrandContent">@color/theme_xuanmo_primary_content</item>
        <item name="colorSecondary">@color/theme_xuanmo_accent</item>
        <item name="colorBrandAccent">@color/theme_xuanmo_accent</item>
        <item name="android:colorAccent">@color/theme_xuanmo_accent</item>
        <item name="android:windowBackground">@color/theme_xuanmo_surface</item>
        <item name="colorSurface">@color/theme_xuanmo_surface</item>
        <item name="android:statusBarColor">@color/theme_xuanmo_primary_variant</item>
    </style>

    <style name="Theme.PomodoroFocus" parent="Theme.Xian.Qinglv" />

    <style name="Widget.Xian.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">?attr/colorBrandSurface</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingVertical">11dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Xian.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">?attr/colorBrandContent</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Xian.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/ink_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Theme.Xian.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Xian.Medium</item>
        <item name="android:windowAnimationStyle">@style/Animation.Xian.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Xian.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Xian.Button.Text</item>
    </style>

    <style name="ShapeAppearance.Xian.Medium" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.Xian.Circle" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Animation.Xian.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
</resources>
