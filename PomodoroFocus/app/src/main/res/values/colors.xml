<resources>
    <!--
      「贤」配色总表
      规则：
        1. 随主题变化的颜色 -> styles.xml 里映射成 ?attr/x，布局用主题属性引用
        2. 随昼夜变化的颜色 -> 在 values-night/colors.xml 里覆盖同名项
        3. 固定语义色（纯白、遮罩、错误红）-> 只在这里定义一次
    -->

    <!-- ========== 4 套主题的色相（values-night 提供深色变体）========== -->
    <!-- 主色分两个角色：primary 做底(header/按钮)，primary_content 做字(文字/图标)
         浅色下两者同值；深色下 primary 变深、primary_content 变浅，保证各自对比度 -->
    <color name="theme_qinglv_primary">#3B5B4E</color>
    <color name="theme_qinglv_primary_content">#3B5B4E</color>
    <color name="theme_qinglv_primary_variant">#2A4238</color>
    <color name="theme_qinglv_accent">#C9A961</color>
    <color name="theme_qinglv_surface">#F5EFE0</color>

    <color name="theme_zhusha_primary">#8B2E2E</color>
    <color name="theme_zhusha_primary_content">#8B2E2E</color>
    <color name="theme_zhusha_primary_variant">#6E211F</color>
    <color name="theme_zhusha_accent">#C9A961</color>
    <color name="theme_zhusha_surface">#F7EEE4</color>

    <color name="theme_dailan_primary">#334E68</color>
    <color name="theme_dailan_primary_content">#334E68</color>
    <color name="theme_dailan_primary_variant">#243B53</color>
    <color name="theme_dailan_accent">#B8A472</color>
    <color name="theme_dailan_surface">#F2F0E8</color>

    <color name="theme_xuanmo_primary">#2B2B2B</color>
    <color name="theme_xuanmo_primary_content">#2B2B2B</color>
    <color name="theme_xuanmo_primary_variant">#1A1A1A</color>
    <color name="theme_xuanmo_accent">#8B7355</color>
    <color name="theme_xuanmo_surface">#F3EEE3</color>

    <!-- ========== 正文与次要文字 ========== -->
    <color name="ink_text">#2B2B2B</color>
    <color name="text_primary">#333333</color>
    <color name="text_secondary">#666666</color>
    <color name="text_tertiary">#999999</color>
    <color name="text_label">#8A7A60</color>
    <color name="hint_text">#A89B82</color>
    <color name="text_dark_brown">#5A4E3A</color>
    <color name="secondary_text">#6B5D4A</color>

    <!-- ========== 卡片与背景 ========== -->
    <color name="card_background">#FFFFFF</color>
    <color name="card_surface">#F0E8D6</color>
    <color name="card_surface_alt">#F0EBE0</color>
    <color name="pale_grey">#F5F5F5</color>
    <color name="nav_divider">#D8CDB8</color>
    <color name="muted_grey">#DDDDDD</color>
    <color name="completed_grey">#9E9E9E</color>
    <color name="pin_dot_empty">#CCCCCC</color>
    <color name="nav_inactive">#8A8A8A</color>
    <color name="diary_dot">#C8C0B0</color>

    <!-- ========== 主色底上的内容（深色模式下不变，保证对比度）========== -->
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#EEEEEE</color>
    <color name="on_primary_muted">#B8C9C0</color>
    <color name="nav_icon_dim">#88FFFFFF</color>

    <!-- ========== 日历（叠在主色头部上，保持固定对比关系）========== -->
    <color name="calendar_chip">#D8E6DF</color>
    <color name="calendar_chip_text">#27463A</color>
    <color name="calendar_gold_light">#E8D5A3</color>
    <color name="calendar_grid">#C0B8A8</color>

    <!-- ========== 状态色 ========== -->
    <color name="success">#2E7D5B</color>
    <color name="danger">#C62828</color>
    <color name="danger_alt">#CC3333</color>
    <color name="warning_orange">#D84315</color>
    <color name="delete_red">#B3261E</color>

    <!-- 左滑动作按钮：功能色，不随主题翻面（白图标压在饱和色块上，昼夜对比度都够） -->
    <color name="swipe_action_done">#26B3A7</color>
    <color name="swipe_action_move_up">#4A8FE0</color>
    <color name="swipe_action_move_down">#E8A33D</color>
    <color name="swipe_action_delete">#E0565A</color>
    <color name="due_text">#A67C00</color>
    <color name="overdue_text">#8B2E2E</color>
    <color name="stat_label">#D4C8A8</color>
    <color name="stat_sub">#A8B8A8</color>
    <color name="holiday_text">#E67E22</color>

    <!-- ========== 筛选胶囊（未选中态）========== -->
    <color name="chip_unselected_bg">#F4F4F4</color>

    <!-- ========== 固定色（不随昼夜变化：都叠在主色块上）========== -->
    <color name="white">#FFFFFF</color>
    <color name="scrim">#CC000000</color>
    <color name="ripple_white">#33FFFFFF</color>
    <color name="category_tag_bg">#333B5B4E</color>
    <color name="calendar_scrim">#40FFFFFF</color>

    <!-- ========== 锁机覆盖层 ==========
         全部是半透明白，叠在「当前主题的品牌色」底上：
         半透明白会和底下任何色相自动调和，所以不用为 4 套主题 × 昼夜各配一份 -->
    <color name="overlay_card_bg">#1FFFFFFF</color>
    <color name="overlay_outline">#4DFFFFFF</color>
    <color name="overlay_divider">#26FFFFFF</color>
    <color name="overlay_scrim">#99000000</color>
    <color name="overlay_confirm_card">#33FFFFFF</color>
    <color name="flip_card_top">#2EFFFFFF</color>
    <color name="flip_card_bottom">#1FFFFFFF</color>
    <color name="flip_card_divider">#38000000</color>
    <color name="flip_card_text">#FFFFFF</color>

    <!-- ========== 旧名兼容 ========== -->
    <color name="primary">@color/theme_qinglv_primary</color>
    <color name="primary_dark">@color/theme_qinglv_primary_variant</color>
    <color name="accent_gold">@color/theme_qinglv_accent</color>
    <color name="paper">@color/theme_qinglv_surface</color>
    <color name="paper_background">@color/theme_qinglv_surface</color>
    <color name="divider">#E0D6C2</color>
    <color name="task_selected_background">@color/category_tag_bg</color>
    <color name="icon_background">#EFE3C8</color>
</resources>
