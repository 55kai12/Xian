<?xml version="1.0" encoding="utf-8"?>
<!--
  叠在品牌色上的卡片底（白名单文件夹行、退出冷静期弹窗共用）。
  半透明白 + 描边，和覆盖层其它元素同一套视觉语言，任何主题色相下都成立。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/overlay_confirm_card" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/overlay_outline" />
</shape>
